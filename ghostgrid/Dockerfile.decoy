FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy ghostgrid source tree into /app/ghostgrid
COPY . /app/ghostgrid

# Run as an unprivileged user. The dashboard image uses the same UID so both can share /data.
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin ghostgrid \
    && mkdir -p /data && chown ghostgrid:ghostgrid /data
USER 10001

# An unprivileged user can't bind ports below 1024, so the decoy listens on 5020 inside the
# container. docker-compose maps the host's port 502 to it, so visitors still see port 502.
EXPOSE 5020

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH=/app
ENV MODBUS_PORT=5020
ENV MODBUS_HOST=0.0.0.0

CMD ["python", "-m", "ghostgrid.run_decoy", "--config", "/app/ghostgrid/config/site.example.yaml"]
